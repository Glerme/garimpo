# Banco. Local (padrão): file:./dados/garimpo.db
# Supabase/Postgres: postgresql://usuario:senha@host:5432/postgres
DATABASE_URL="file:./dados/garimpo.db"

# Segredo que cifra as chaves salvas no painel. O `npm run setup` gera um.
# Na Vercel, crie a variável APP_SECRET com 32+ caracteres aleatórios.
APP_SECRET=""

# Endereço público do sistema (links de prévia, checkout e webhooks).
APP_URL="http://localhost:3000"
